<controls:BaseWindow x:Class="ExplorerTabUtility.UI.Views.BookmarkManagePopup"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:language="clr-namespace:ExplorerTabUtility.Languages.Manager"
                     xmlns:controls="clr-namespace:ExplorerTabUtility.UI.Views.Controls"
                     WindowStartupLocation="CenterScreen"
                     SizeToContent="Manual"
                     Style="{StaticResource BaseWindowStyle}"
                     Width="800" Height="600">
    <Border Style="{StaticResource BaseWindowBorderStyle}">
        <Grid Margin="10 5 10 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="书签管理" Style="{StaticResource BookmarkTitleTextBlock}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="书签文件夹" Style="{StaticResource BookmarkTitleTextBlock}"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="书签列表" Style="{StaticResource BookmarkTitleTextBlock}"/>

            <controls:BookmarkTreeView x:Name="TvSelectSavePath" Grid.Row="2" Grid.Column="0" Style="{StaticResource BookmarkSaveTreeViewStyle}"/>

            <ListBox Grid.Row="2" Grid.Column="2"/>

            <StackPanel Grid.Row="3" Grid.Column="0" HorizontalAlignment="Left">
                <Button x:Name="BtnNewFolder" Style="{StaticResource BookmarkButtonStyle}" Width="110"
                        Content="新建文件夹"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Style="{StaticResource BookmarkButtonStyle}"
                        Content="{Binding LanguageFields.Save,Source={x:Static language:LangeuageHelper.Instance}}"/>
                <Button x:Name="BtnCancel" Style="{StaticResource BookmarkButtonStyle}"
                        Content="{Binding LanguageFields.Cancel,Source={x:Static language:LangeuageHelper.Instance}}"/>
            </StackPanel>
        </Grid>
    </Border>
</controls:BaseWindow>
