<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:ExplorerTabUtility.Models"
                    xmlns:behaviors="clr-namespace:ExplorerTabUtility.UI.Behaviors">

    <!-- Navigation ListBoxItem Style -->
    <Style x:Key="NavigationListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12, 10" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource BorderGradientBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation ListBox Style -->
    <Style x:Key="NavigationListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0,6" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource NavigationListBoxItemStyle}" />
    </Style>

    <!-- 多选右键菜单 -->
    <ContextMenu x:Key="BookmarkListBoxMultiSelectContextMenu">
        <MenuItem Header="删除"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.Delete}"/>
    </ContextMenu>

    <!-- 文件夹的右键菜单 -->
    <ContextMenu x:Key="FolderListBoxItemContextMenu">
        <MenuItem Header="重命名"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.Rename}"/>
        <MenuItem Header="删除"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.Delete}"/>
    </ContextMenu>

    <!-- 书签的右键菜单 -->
    <ContextMenu x:Key="BookmarkListBoxItemContextMenu">
        <MenuItem Header="编辑"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.Edit}"/>
        <MenuItem Header="删除"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.Delete}"/>
        <Separator/>
        <MenuItem Header="在当前标签页打开"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.OpenInCurrentTab}"/>
        <MenuItem Header="在新标签页打开"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.OpenInNewTab}"/>
        <MenuItem Header="在新窗口打开"
                  Command="{Binding PlacementTarget.DataContext.MenuClickCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                  CommandParameter="{x:Static model:BookmarkAction.OpenInNewWindow}"/>
    </ContextMenu>

    <!-- Bookmark ListBox Icon Style -->
    <Style x:Key="BookmarkListBoxIconStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0 0 10 0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bookmark ListBoxItem Style -->
    <Style x:Key="BookmarkListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12, 10" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Style="{StaticResource BookmarkListBoxIconStyle}"/>
                            <ContentPresenter />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=(behaviors:ListBoxHelper.IsMultipleSelected),RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True">
                <Setter Property="ContextMenu" Value="{StaticResource BookmarkListBoxMultiSelectContextMenu}"/>
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(behaviors:ListBoxHelper.IsMultipleSelected),RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False"/>
                    <Condition Binding="{Binding IsFolder}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="ContextMenu" Value="{StaticResource FolderListBoxItemContextMenu}"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Path=(behaviors:ListBoxHelper.IsMultipleSelected),RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="False"/>
                    <Condition Binding="{Binding IsFolder}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="ContextMenu" Value="{StaticResource BookmarkListBoxItemContextMenu}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Bookmark ListBox Style -->
    <Style x:Key="BookmarkListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BookmarkListBoxItemStyle}" />
        <Setter Property="DisplayMemberPath" Value="Name"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="behaviors:ListBoxHelper.MonitorSelection" Value="True"/>
    </Style>
</ResourceDictionary>